-- ============================================================
-- recv_path.kl - Reception des points du dessin (Socket Messaging)
-- Robot : FANUC LR Mate 200iD/4S - Controleur R-30iB Mate
--
-- LE ROBOT EST SERVEUR : il ecoute sur le port 59002 (tag S2) et
-- ATTEND la connexion du PC. C'est le PC (step3_ascii.py) qui se
-- connecte au robot comme client.
--
-- Configuration prealable (UNE FOIS, sur le pendant) :
--   MENUS > SETUP > Host Comm > F4 SHOW > Servers > tag S2 > F3 DETAIL
--     Protocol Name = SM
--     Startup State = START
--     Port          = 59002
--   puis F2 ACTION > DEFINE, F2 ACTION > START
--   (equivalent variable systeme : $HOSTS_CFG[2].$SERVER_PORT = 59002)
--
-- Creation de dessin a partir d'une image : UNE SEULE trame contient
-- TOUT le dessin :
--   ligne 1   : nombre TOTAL de points n
--   lignes 2..: n fois "X Y Z W P R" separes par des blancs (CR final)
-- La trame inclut deja les deplacements feutre LEVE entre les formes
-- (points a Z_TRAVEL_MM) : le TP parcourt simplement les PR dans l'ordre.
--
-- Les points sont stockes EN CONTINU dans PR[10] a PR[10+n-1].
-- ============================================================

PROGRAM recv_path
%NOLOCKGROUP
%ENVIRONMENT flbt     -- socket messaging (MSG_CONNECT, MSG_DISCO)
%ENVIRONMENT fdev     -- operations fichier (OPEN FILE, READ, WRITE)
%ENVIRONMENT bynam    -- variables systeme (SET_VAR)
%ENVIRONMENT kclop
%INCLUDE klevccdf

CONST
  PR_BASE = 10        -- premier PR utilise pour les points recus

VAR
  file_var : FILE
  status   : INTEGER
  n_points : INTEGER
  i        : INTEGER
  rx, ry, rz, rw, rp, rr : REAL
  entry    : INTEGER

BEGIN
  SET_FILE_ATR(file_var, ATR_IA)
  -- $HOSTS_CFG = tags SERVEUR : le robot ecoute sur ce port
  SET_VAR(entry, '*SYSTEM*', '$HOSTS_CFG[2].$SERVER_PORT', 59002, status)

  MSG_CONNECT('S2:', status)   -- attend que le PC se connecte
  IF status = 0 THEN
    OPEN FILE file_var ('rw', 'S2:')
    status = IO_STATUS(file_var)
    IF status = 0 THEN
      -- Lecture du nombre TOTAL de points du dessin
      READ file_var(n_points)
      status = IO_STATUS(file_var)
      IF status = 0 THEN
        FOR i = 1 TO n_points DO
          READ file_var(rx, ry, rz, rw, rp, rr)
          status = IO_STATUS(file_var)
          IF status <> 0 THEN
            WRITE file_var('ERR')
            EXIT
          ENDIF
          -- Ecriture en continu dans le PR (selon vos built-ins disponibles) :
          -- SET_POS_REG(PR_BASE + i - 1, POS(rx,ry,rz,rw,rp,rr,conf), status)
        ENDFOR
        IF status = 0 THEN
          WRITE file_var('ACK')   -- accuse au PC (step3 attend cette reponse)
        ENDIF
      ELSE
        WRITE file_var('ERR')
      ENDIF
      CLOSE FILE file_var
    ENDIF
    MSG_DISCO('S2:', status)
  ENDIF
END recv_path
