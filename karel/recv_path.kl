-- ============================================================
-- recv_path.kl - Lecture d'un LOT du dessin dans DESSIN.TXT
-- Robot : FANUC LR Mate 200iD/4S - Controleur R-30iB Mate
--
-- OPTION A : l'option User Socket Messaging (R648) n'est pas
-- installee sur ce controleur, il n'y a donc pas de socket KAREL.
-- Le PC depose le dessin dans un FICHIER ASCII (DESSIN.TXT) sur la
-- cle USB du controleur (peripherique UD1:), et ce programme le lit.
-- Si le fichier est depose par FTP, il arrive dans MD: : remplacer
-- UD1: par MD: dans l'instruction OPEN FILE ci-dessous.
--
-- FICHIER DESSIN.TXT (cree par pipeline/step3_ascii.py, unites mm) :
--   ligne 1                  : nombre de trajectoires (lots)
--   pour chaque trajectoire :
--       1 ligne              : nombre de points du lot
--       n lignes             : "X Y Z W P R"
--
-- APPEL : le TP MAIN appelle RECV_PATH une fois par LOT. A chaque
-- appel :
--   - les lots deja traces (compteur R[5]) sont sautes ;
--   - le lot suivant est charge dans PR[74..] (n points) ;
--   - R[3] = n (0 si le dessin est termine) ;
--   - R[4] = trajectoires restantes ; R[5] = R[5] + 1.
-- Le fichier est relu a chaque appel : le programme est sans etat,
-- un appel manque ne desynchronise rien.
--
-- REGISTRES UTILISES : R[3], R[4], R[5] (ecrits ici) + R[1], R[2]
-- (boucle du TP). POINTS : PR[74] a PR[100] seulement (27 PR reserves
-- au dessin ; les autres PR de la cellule sont occupes : ne pas
-- changer PR_BASE sans mettre a jour le MAIN et LOT_MAX_POINTS cote
-- PC).
--
-- PR[9]  : point d approche du TP MAIN (J PR[9]).
-- PR[10] : MODELE (configuration du robot, UFRAME, UTOOL) : enseigne
--          une fois pres du support, JAMAIS ecrase par ce programme.
--
-- La cle USB doit etre branchee avant de lancer MAIN.
-- ============================================================

PROGRAM recv_path
%NOLOCKGROUP
%ENVIRONMENT fdev     -- OPEN FILE, READ, CLOSE FILE
%ENVIRONMENT REGOPE   -- GET/SET_POS_REG, GET/SET_INT_REG, GET_REG
%ENVIRONMENT PBCORE   -- POST_ERR
%INCLUDE klevccdf

CONST
  PR_BASE    = 74     -- premier PR des points du lot (27 PR : 74..100)
  MODEL_PR   = 10     -- PR modele (enseigne, jamais ecrase)
  REG_N      = 3      -- R[3] : nombre de points du lot (lu par le TP)
  REG_REST   = 4      -- R[4] : trajectoires restantes
  REG_FAITS  = 5      -- R[5] : trajectoires deja tracees
  MAX_POINTS = 27     -- garde-fou : = LOT_MAX_POINTS cote PC

VAR
  file_var : FILE
  status   : INTEGER
  n_traj   : INTEGER
  n_points : INTEGER
  i, j     : INTEGER
  faits    : INTEGER
  reel     : REAL
  est_reel : BOOLEAN
  rx, ry, rz, rw, rp, rr : REAL
  pos_data : XYZWPREXT

BEGIN
  SET_INT_REG(REG_N, 0, status)          -- par defaut : rien a tracer

  OPEN FILE file_var ('RO', 'UD1:DESSIN.TXT')
  status = IO_STATUS(file_var)
  IF status = 0 THEN
    READ file_var(n_traj)
    status = IO_STATUS(file_var)
    IF status = 0 THEN
      GET_REG(REG_FAITS, est_reel, faits, reel, status)
      IF status = 0 THEN
        IF faits >= n_traj THEN
          SET_INT_REG(REG_N, 0, status)  -- dessin termine
        ELSE
          -- 1) sauter les trajectoires deja tracees
          FOR i = 1 TO faits DO
            IF status <> 0 THEN
              EXIT
            ENDIF
            READ file_var(n_points)
            status = IO_STATUS(file_var)
            FOR j = 1 TO n_points DO
              IF status <> 0 THEN
                EXIT
              ENDIF
              READ file_var(rx, ry, rz, rw, rp, rr)
              status = IO_STATUS(file_var)
            ENDFOR
          ENDFOR

          -- 2) charger le lot suivant dans PR[74..]
          IF status = 0 THEN
            READ file_var(n_points)
            status = IO_STATUS(file_var)
            IF status = 0 THEN
              IF n_points > MAX_POINTS THEN
                WRITE TPERROR ('RECV_PATH: lot trop grand (MAX_POINTS)')
                SET_INT_REG(REG_N, 0, status)
              ELSE
                pos_data = GET_POS_REG(MODEL_PR, status)
                IF status = 0 THEN
                  FOR j = 1 TO n_points DO
                    IF status <> 0 THEN
                      EXIT
                    ENDIF
                    READ file_var(rx, ry, rz, rw, rp, rr)
                    status = IO_STATUS(file_var)
                    IF status = 0 THEN
                      pos_data.x = rx
                      pos_data.y = ry
                      pos_data.z = rz
                      pos_data.w = rw
                      pos_data.p = rp
                      pos_data.r = rr
                      SET_POS_REG(PR_BASE + j - 1, pos_data, status)
                    ENDIF
                  ENDFOR
                  IF status = 0 THEN
                    SET_INT_REG(REG_REST, n_traj - faits - 1, status)
                    SET_INT_REG(REG_FAITS, faits + 1, status)
                    SET_INT_REG(REG_N, n_points, status)
                  ELSE
                    POST_ERR(status, 'DESSIN.TXT', 0, 1)
                    SET_INT_REG(REG_N, 0, status)
                  ENDIF
                ELSE
                  POST_ERR(status, 'PR[10] absent', 0, 1)
                ENDIF
              ENDIF
            ELSE
              POST_ERR(status, 'DESSIN.TXT', 0, 1)
            ENDIF
          ELSE
            POST_ERR(status, 'DESSIN.TXT', 0, 1)
          ENDIF
        ENDIF
      ELSE
        POST_ERR(status, 'R[5]', 0, 1)
      ENDIF
    ELSE
      POST_ERR(status, 'DESSIN.TXT', 0, 1)
    ENDIF
    CLOSE FILE file_var
  ELSE
    POST_ERR(status, 'UD1:DESSIN.TXT', 0, 1)
  ENDIF
END recv_path
