-- ============================================================
-- recv_path.kl - Reception des points du dessin (Socket Messaging)
-- Robot : FANUC LR Mate 200iD/4S - Controleur R-30iB Mate
--
-- LE ROBOT EST SERVEUR (tag S2, port 59002) : il ATTEND que le PC
-- (pipeline/step3_ascii.py) vienne se connecter comme client.
--
-- CONFIGURATION PREALABLE (UNE FOIS, sur le pendant) :
--   MENUS > SETUP > Host Comm > F4 SHOW > Servers > tag S2 > F3 DETAIL
--     Protocol Name = SM ; Startup State = START ; Port = 59002
--   puis F2 ACTION > DEFINE, F2 ACTION > START
--   (equivalent : $HOSTS_CFG[2].$SERVER_PORT = 59002)
--
-- AVANT CHAQUE UTILISATION : enseigner PR[10] pres du support avec
-- le stylo (il sert de MODELE : configuration du robot, UFRAME, UTOOL).
--
-- TRAME RECUE (tout le dessin en une seule connexion) :
--   ligne 1  : nombre TOTAL de points n
--   lignes 2-: n fois "X Y Z W P R" separes par des blancs (CR final)
--
-- RESULTAT :
--   - points ranges en continu dans PR[10] a PR[10+n-1]
--   - nombre de points range dans R[50] (lu par le programme TP MAIN)
--   - reponse 'ACK' envoyee au PC
-- ============================================================

PROGRAM recv_path
%NOLOCKGROUP
%ENVIRONMENT flbt     -- socket messaging (MSG_CONNECT, MSG_DISCO)
%ENVIRONMENT fdev     -- operations fichier (OPEN FILE, READ, WRITE)
%ENVIRONMENT bynam    -- variables systeme (SET_VAR)
%ENVIRONMENT kclop
%ENVIRONMENT REGOPE   -- registres et PR (GET_POS_REG, SET_POS_REG, SET_INT_REG)
%INCLUDE klevccdf

CONST
  PR_BASE = 10        -- premier PR des points recus
  REG_N   = 50        -- registre ou le TP lit le nombre de points

VAR
  file_var : FILE
  status   : INTEGER
  n_points : INTEGER
  i        : INTEGER
  rx, ry, rz, rw, rp, rr : REAL
  entry    : INTEGER
  pos_data : XYZWPREXT

BEGIN
  SET_FILE_ATR(file_var, ATR_IA)
  SET_VAR(entry, '*SYSTEM*', '$HOSTS_CFG[2].$SERVER_PORT', 59002, status)

  MSG_CONNECT('S2:', status)   -- attend la connexion du PC
  IF status = 0 THEN
    OPEN FILE file_var ('rw', 'S2:')
    status = IO_STATUS(file_var)
    IF status = 0 THEN
      -- Nombre TOTAL de points du dessin
      READ file_var(n_points)
      status = IO_STATUS(file_var)
      IF status = 0 THEN
        -- PR[10] enseigne = modele (configuration, UFRAME, UTOOL)
        pos_data = GET_POS_REG(PR_BASE, status)
        FOR i = 1 TO n_points DO
          READ file_var(rx, ry, rz, rw, rp, rr)
          status = IO_STATUS(file_var)
          IF status <> 0 THEN
            WRITE file_var('ERR')
            EXIT
          ENDIF
          pos_data.x = rx
          pos_data.y = ry
          pos_data.z = rz
          pos_data.w = rw
          pos_data.p = rp
          pos_data.r = rr
          SET_POS_REG(PR_BASE + i - 1, pos_data, status)
          IF status <> 0 THEN
            WRITE file_var('ERR')
            EXIT
          ENDIF
        ENDFOR
        IF status = 0 THEN
          SET_INT_REG(REG_N, n_points, status)   -- n pour le TP
          WRITE file_var('ACK')                  -- accuse pour le PC
        ENDIF
      ELSE
        WRITE file_var('ERR')
      ENDIF
      CLOSE FILE file_var
    ENDIF
    MSG_DISCO('S2:', status)
  ENDIF
END recv_path
