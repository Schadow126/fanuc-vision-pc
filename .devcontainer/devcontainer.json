{
  // Conteneur de developpement VS Code (extension Dev Containers requise)
  // Commande : "Dev Containers: Reopen in Container"
  "name": "fanuc-vision-pc",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8000],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 libglib2.0-0 && pip install -r requirements.txt",
  "remoteEnv": {
    "DEMO": "1",
    "ROBOT_IP": "192.168.1.10",
    "PLC_IP": "192.168.1.1",
    "Z_MM": "-15.0",
    "Z_TRAVEL_MM": "-80.0"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
